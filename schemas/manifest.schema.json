{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s/@]+(?:[/?#][^\\s]*)?$",
      "description": "HTTPS provenance only. Runtime also rejects credentials, malformed ports and control characters."
    }
  },
  "required": [
    "id",
    "sha256"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single corpus manifest record (one JSONL line)"
}
