{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s/@]+(?:[/?#][^\\s]*)?$",
            "description": "HTTPS provenance only. Runtime also rejects credentials, malformed ports and control characters."
          },
          "category": {
            "enum": [
              "data_poisoning",
              "model_backdoor",
              "prompt_injection",
              "unsafe_training_content"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "expires_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "sha256",
          "source_url",
          "category",
          "reason",
          "expires_at"
        ]
      }
    },
    "omitted": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed corpus exclusion export"
}
